#!/bin/sh
# Blocks commits that would leak secrets: staged .env files or anything that looks like an API key.
# Enable once per clone:  git config core.hooksPath .githooks

fail=0

# 1. .env files staged anyway (e.g. with `git add -f`). The .env.example template is allowed.
env_files=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '(^|/)\.env\.example$')
if [ -n "$env_files" ]; then
  echo "pre-commit: refusing to commit .env files:"
  echo "$env_files" | sed 's/^/  /'
  fail=1
fi

# 2. Known API key / private key formats in any staged file.
#    Google (Gemini) AIza..., Groq gsk_..., OpenRouter sk-or-..., PEM private keys.
key_pattern='AIza[0-9A-Za-z_-]{35}|gsk_[0-9A-Za-z]{20,}|sk-or-v1-[0-9a-f]{32,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
key_files=$(git grep --cached -l -E -e "$key_pattern" -- .)
if [ -n "$key_files" ]; then
  echo "pre-commit: these staged files look like they contain an API key or private key:"
  echo "$key_files" | sed 's/^/  /'
  echo "Move the key into a .env file and read it from the environment instead."
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "Commit blocked. Unstage with: git restore --staged <file>"
  exit 1
fi
