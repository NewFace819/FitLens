{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Exercise": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "exercise_id": {
          "anyOf": [
            {
              "enum": [
                "squat",
                "push_up",
                "lunge",
                "plank",
                "glute_bridge",
                "jumping_jack",
                "crunch",
                "mountain_climber"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Catalog id if this is that movement or a close variation, else null.",
          "title": "Exercise Id"
        },
        "sets": {
          "minimum": 1,
          "title": "Sets",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepsTarget"
            },
            {
              "$ref": "#/$defs/TimeTarget"
            }
          ],
          "description": "Per set.",
          "title": "Target"
        },
        "per_side": {
          "description": "True if the target is done for each side/leg/arm.",
          "title": "Per Side",
          "type": "boolean"
        },
        "rest_seconds": {
          "minimum": 0,
          "title": "Rest Seconds",
          "type": "integer"
        },
        "form_tip": {
          "title": "Form Tip",
          "type": "string"
        }
      },
      "required": [
        "name",
        "exercise_id",
        "sets",
        "target",
        "per_side",
        "rest_seconds",
        "form_tip"
      ],
      "title": "Exercise",
      "type": "object"
    },
    "Generator": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt_version"
      ],
      "title": "Generator",
      "type": "object"
    },
    "RepsTarget": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "reps",
          "title": "Type",
          "type": "string"
        },
        "min": {
          "minimum": 1,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "description": "Same as min for a fixed number of reps.",
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "min",
        "max"
      ],
      "title": "RepsTarget",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Short session title, e.g. 'Lower body & core'. No day name.",
          "title": "Title",
          "type": "string"
        },
        "estimated_minutes": {
          "minimum": 1,
          "title": "Estimated Minutes",
          "type": "integer"
        },
        "warmup": {
          "items": {
            "type": "string"
          },
          "title": "Warmup",
          "type": "array"
        },
        "exercises": {
          "items": {
            "$ref": "#/$defs/Exercise"
          },
          "title": "Exercises",
          "type": "array"
        },
        "cooldown": {
          "items": {
            "type": "string"
          },
          "title": "Cooldown",
          "type": "array"
        },
        "weekday": {
          "description": "ISO weekday: 1 = Monday ... 7 = Sunday.",
          "maximum": 7,
          "minimum": 1,
          "title": "Weekday",
          "type": "integer"
        }
      },
      "required": [
        "title",
        "estimated_minutes",
        "warmup",
        "exercises",
        "cooldown",
        "weekday"
      ],
      "title": "Session",
      "type": "object"
    },
    "TimeTarget": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "time",
          "title": "Type",
          "type": "string"
        },
        "seconds": {
          "minimum": 1,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "seconds"
      ],
      "title": "TimeTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/Generator"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "schedule_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Message about the schedule, e.g. too few free days.",
      "title": "Schedule Note"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/Session"
      },
      "title": "Sessions",
      "type": "array"
    },
    "progression_tips": {
      "items": {
        "type": "string"
      },
      "title": "Progression Tips",
      "type": "array"
    },
    "safety_note": {
      "title": "Safety Note",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "generator",
    "title",
    "summary",
    "sessions",
    "progression_tips",
    "safety_note"
  ],
  "title": "Plan",
  "type": "object"
}
